# SQL style: dbt Labs' guide
# (https://docs.getdbt.com/best-practices/how-we-style/2-how-we-style-our-sql),
# enforced by SQLFluff. Based on dbt Labs' own config in jaffle-shop, with the
# Databricks dialect. Run locally: .venv/bin/sqlfluff lint models tests macros
# dbt Studio's Lint and Format buttons read this file too.

[sqlfluff]
dialect = databricks
# The plain jinja templater renders ref()/source() as stand-in names, so
# linting needs no warehouse connection and no credentials (CI runs it with
# no secrets). The project's own macros are loaded from macros/.
templater = jinja
runaway_limit = 10
max_line_length = 80
indent_unit = space
# ST06 (structure.column_order) wants every plain column before any
# expression, even trim(x) or a calculated key. dbt Labs' guide asks only for
# plain fields before aggregates and window functions (checked in review).
# Applying ST06 would reorder the output columns of almost every model and
# break the keys-first grouping the marts use.
exclude_rules = structure.column_order

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
load_macros_from_path = macros

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:layout:type:comma]
spacing_before = touch
line_position = trailing

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:aliasing.expression]
allow_scalar = False

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:ambiguous.column_references]
# group by 1, 2 / order by 1 (by position), not by name
group_by_and_order_by_style = implicit
