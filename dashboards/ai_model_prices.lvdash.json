{
  "datasets": [
    {
      "name": "ds_models",
      "displayName": "Notable models with a current price",
      "queryLines": [
        "select\n",
        "    model_name,\n",
        "    organization,\n",
        "    cast(release_year as string) as release_year,\n",
        "    case when is_open_weights then 'Open weights' else 'Closed' end as weights,\n",
        "    access_type,\n",
        "    priced_listing_id,\n",
        "    -- DOUBLE only for display: the dashboard formats floating-point numbers,\n",
        "    -- not DECIMAL\n",
        "    cast(input_price_usd_per_mtok as double) as input_price_usd_per_mtok,\n",
        "    cast(output_price_usd_per_mtok as double) as output_price_usd_per_mtok,\n",
        "    cast(\n",
        "        cached_input_price_usd_per_mtok as double\n",
        "    ) as cached_input_price_usd_per_mtok,\n",
        "    context_length_tokens,\n",
        "    standard_listings,\n",
        "    price_as_of_date,\n",
        "    case\n",
        "        when output_price_usd_per_mtok < 1 then 'Under $1'\n",
        "        when output_price_usd_per_mtok < 3 then '$1 to $3'\n",
        "        when output_price_usd_per_mtok < 10 then '$3 to $10'\n",
        "        when output_price_usd_per_mtok < 30 then '$10 to $30'\n",
        "        else '$30 and over'\n",
        "    end as price_band\n",
        "from rpt_models_latest_price\n",
        "where has_price\n",
        "order by 8  -- output_price_usd_per_mtok"
      ],
      "columns": [
        {
          "displayName": "Priced Models",
          "description": "Notable models with a current standard price",
          "expression": "COUNT(`model_name`)"
        },
        {
          "displayName": "Median Output Price",
          "description": "Median USD per million output tokens",
          "expression": "CAST(MEDIAN(`output_price_usd_per_mtok`) AS DOUBLE)"
        },
        {
          "displayName": "Median Output Price Open",
          "description": "Median output price, open-weights models",
          "expression": "CAST(MEDIAN(CASE WHEN `weights` = 'Open weights' THEN `output_price_usd_per_mtok` END) AS DOUBLE)"
        },
        {
          "displayName": "Median Output Price Closed",
          "description": "Median output price, closed models",
          "expression": "CAST(MEDIAN(CASE WHEN `weights` = 'Closed' THEN `output_price_usd_per_mtok` END) AS DOUBLE)"
        }
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "OpenRouter catalogue per day",
      "queryLines": [
        "select\n",
        "    snapshot_date,\n",
        "    count(*) as listings,\n",
        "    count(distinct epoch_model_name) as notable_models_listed,\n",
        "    sum(\n",
        "        case when is_variable_priced then 1 else 0 end\n",
        "    ) as variable_priced_listings\n",
        "from fct_model_prices_daily\n",
        "group by 1\n",
        "order by 1"
      ]
    },
    {
      "name": "ds_latest",
      "displayName": "Latest snapshot",
      "queryLines": [
        "select\n",
        "    snapshot_date as latest_snapshot_date,\n",
        "    count(*) as listings,\n",
        "    count(distinct epoch_model_name) as notable_models_listed\n",
        "from fct_model_prices_daily\n",
        "where\n",
        "    snapshot_date = (\n",
        "        select max(snapshot_date) as max_snapshot_date\n",
        "        from fct_model_prices_daily\n",
        "    )\n",
        "group by 1"
      ]
    },
    {
      "name": "ds_org",
      "displayName": "Priced models by organisation",
      "queryLines": [
        "with priced as (\n",
        "\n",
        "    select\n",
        "        organization,\n",
        "        case\n",
        "            when is_open_weights then 'Open weights'\n",
        "            else 'Closed'\n",
        "        end as weights\n",
        "    from rpt_models_latest_price\n",
        "    where has_price\n",
        "\n",
        "),\n",
        "\n",
        "top_orgs as (\n",
        "\n",
        "    select organization\n",
        "    from priced\n",
        "    group by 1\n",
        "    order by count(*) desc, organization asc\n",
        "    limit 10\n",
        "\n",
        ")\n",
        "\n",
        "select\n",
        "    case\n",
        "        when top_orgs.organization is not null then priced.organization\n",
        "        else 'Other'\n",
        "    end as organization_group,\n",
        "    priced.weights,\n",
        "    count(*) as priced_models\n",
        "from priced\n",
        "left join top_orgs\n",
        "    on priced.organization = top_orgs.organization\n",
        "group by 1, 2\n",
        "order by 3 desc"
      ]
    },
    {
      "name": "ds_changes",
      "displayName": "Price changes",
      "queryLines": [
        "with prices as (\n",
        "\n",
        "    select\n",
        "        openrouter_model_id,\n",
        "        epoch_model_name,\n",
        "        snapshot_date,\n",
        "        input_price_usd_per_mtok,\n",
        "        output_price_usd_per_mtok\n",
        "    from fct_model_prices_daily\n",
        "    where\n",
        "        epoch_model_name is not null\n",
        "        and pricing_variant = 'standard'\n",
        "\n",
        "),\n",
        "\n",
        "per_listing as (\n",
        "\n",
        "    select\n",
        "        openrouter_model_id,\n",
        "        epoch_model_name,\n",
        "        min(snapshot_date) as first_seen,\n",
        "        max(snapshot_date) as last_seen,\n",
        "        min_by(input_price_usd_per_mtok, snapshot_date) as first_input_price,\n",
        "        max_by(input_price_usd_per_mtok, snapshot_date) as latest_input_price,\n",
        "        min_by(output_price_usd_per_mtok, snapshot_date) as first_output_price,\n",
        "        max_by(output_price_usd_per_mtok, snapshot_date) as latest_output_price,\n",
        "        count(distinct input_price_usd_per_mtok) > 1\n",
        "        or count(distinct output_price_usd_per_mtok) > 1 as price_changed\n",
        "    from prices\n",
        "    group by 1, 2\n",
        "\n",
        ")\n",
        "\n",
        "select\n",
        "    per_listing.epoch_model_name as model_name,\n",
        "    dim_models.organization,\n",
        "    per_listing.openrouter_model_id,\n",
        "    per_listing.first_seen,\n",
        "    per_listing.last_seen,\n",
        "    -- DOUBLE only for display: the dashboard formats floating-point numbers,\n",
        "    -- not DECIMAL\n",
        "    cast(per_listing.first_input_price as double) as first_input_price,\n",
        "    cast(per_listing.latest_input_price as double) as latest_input_price,\n",
        "    cast(per_listing.first_output_price as double) as first_output_price,\n",
        "    cast(per_listing.latest_output_price as double) as latest_output_price,\n",
        "    cast(\n",
        "        round(\n",
        "            case\n",
        "                when per_listing.first_output_price > 0\n",
        "                    then\n",
        "                        100\n",
        "                        * (\n",
        "                            per_listing.latest_output_price\n",
        "                            - per_listing.first_output_price\n",
        "                        )\n",
        "                        / per_listing.first_output_price\n",
        "            end,\n",
        "            0\n",
        "        ) as double\n",
        "    ) as output_price_change_pct\n",
        "from per_listing\n",
        "inner join dim_models\n",
        "    on per_listing.epoch_model_name = dim_models.model_name\n",
        "where per_listing.price_changed\n",
        "order by\n",
        "    abs(\n",
        "        coalesce(\n",
        "            per_listing.latest_output_price - per_listing.first_output_price,\n",
        "            0\n",
        "        )\n",
        "    ) desc,\n",
        "    per_listing.epoch_model_name asc"
      ]
    }
  ],
