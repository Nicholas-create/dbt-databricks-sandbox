{
  "datasets": [
    {
      "name": "ds_models",
      "displayName": "Notable models with a current price",
      "queryLines": [
        "SELECT\n",
        "  model_name,\n",
        "  organization,\n",
        "  CAST(release_year AS STRING) AS release_year,\n",
        "  CASE WHEN is_open_weights THEN 'Open weights' ELSE 'Closed' END AS weights,\n",
        "  access_type,\n",
        "  priced_listing_id,\n",
        "  -- DOUBLE only for display: the dashboard formats floating-point numbers, not DECIMAL\n",
        "  CAST(input_price_usd_per_mtok AS DOUBLE) AS input_price_usd_per_mtok,\n",
        "  CAST(output_price_usd_per_mtok AS DOUBLE) AS output_price_usd_per_mtok,\n",
        "  CAST(cached_input_price_usd_per_mtok AS DOUBLE) AS cached_input_price_usd_per_mtok,\n",
        "  context_length_tokens,\n",
        "  standard_listings,\n",
        "  price_as_of_date,\n",
        "  CASE\n",
        "    WHEN output_price_usd_per_mtok < 1  THEN 'Under $1'\n",
        "    WHEN output_price_usd_per_mtok < 3  THEN '$1 to $3'\n",
        "    WHEN output_price_usd_per_mtok < 10 THEN '$3 to $10'\n",
        "    WHEN output_price_usd_per_mtok < 30 THEN '$10 to $30'\n",
        "    ELSE '$30 and over'\n",
        "  END AS price_band\n",
        "FROM rpt_models_latest_price\n",
        "WHERE has_price\n",
        "ORDER BY output_price_usd_per_mtok"
      ],
      "columns": [
        {
          "displayName": "Priced Models",
          "description": "Notable models with a current standard price",
          "expression": "COUNT(`model_name`)"
        },
        {
          "displayName": "Median Output Price",
          "description": "Median USD per million output tokens",
          "expression": "CAST(MEDIAN(`output_price_usd_per_mtok`) AS DOUBLE)"
        },
        {
          "displayName": "Median Output Price Open",
          "description": "Median output price, open-weights models",
          "expression": "CAST(MEDIAN(CASE WHEN `weights` = 'Open weights' THEN `output_price_usd_per_mtok` END) AS DOUBLE)"
        },
        {
          "displayName": "Median Output Price Closed",
          "description": "Median output price, closed models",
          "expression": "CAST(MEDIAN(CASE WHEN `weights` = 'Closed' THEN `output_price_usd_per_mtok` END) AS DOUBLE)"
        }
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "OpenRouter catalogue per day",
      "queryLines": [
        "SELECT\n",
        "  snapshot_date,\n",
        "  COUNT(*) AS listings,\n",
        "  COUNT(DISTINCT epoch_model_name) AS notable_models_listed,\n",
        "  SUM(CASE WHEN is_variable_priced THEN 1 ELSE 0 END) AS variable_priced_listings\n",
        "FROM fct_model_prices_daily\n",
        "GROUP BY snapshot_date\n",
        "ORDER BY snapshot_date"
      ]
    },
    {
      "name": "ds_latest",
      "displayName": "Latest snapshot",
      "queryLines": [
        "SELECT\n",
        "  snapshot_date AS latest_snapshot_date,\n",
        "  COUNT(*) AS listings,\n",
        "  COUNT(DISTINCT epoch_model_name) AS notable_models_listed\n",
        "FROM fct_model_prices_daily\n",
        "WHERE snapshot_date = (SELECT MAX(snapshot_date) FROM fct_model_prices_daily)\n",
        "GROUP BY snapshot_date"
      ]
    },
    {
      "name": "ds_org",
      "displayName": "Priced models by organisation",
      "queryLines": [
        "WITH priced AS (\n",
        "  SELECT organization, CASE WHEN is_open_weights THEN 'Open weights' ELSE 'Closed' END AS weights\n",
        "  FROM rpt_models_latest_price\n",
        "  WHERE has_price\n",
        "),\n",
        "top_orgs AS (\n",
        "  SELECT organization FROM priced GROUP BY organization ORDER BY COUNT(*) DESC, organization LIMIT 10\n",
        ")\n",
        "SELECT\n",
        "  CASE WHEN t.organization IS NOT NULL THEN p.organization ELSE 'Other' END AS organization_group,\n",
        "  p.weights,\n",
        "  COUNT(*) AS priced_models\n",
        "FROM priced p\n",
        "LEFT JOIN top_orgs t ON p.organization = t.organization\n",
        "GROUP BY 1, 2\n",
        "ORDER BY priced_models DESC"
      ]
    },
    {
      "name": "ds_changes",
      "displayName": "Price changes",
      "queryLines": [
        "WITH prices AS (\n",
        "  SELECT\n",
        "    f.openrouter_model_id, f.epoch_model_name, f.snapshot_date,\n",
        "    f.input_price_usd_per_mtok, f.output_price_usd_per_mtok\n",
        "  FROM fct_model_prices_daily f\n",
        "  WHERE f.epoch_model_name IS NOT NULL AND f.pricing_variant = 'standard'\n",
        "),\n",
        "per_listing AS (\n",
        "  SELECT\n",
        "    openrouter_model_id,\n",
        "    epoch_model_name,\n",
        "    MIN(snapshot_date) AS first_seen,\n",
        "    MAX(snapshot_date) AS last_seen,\n",
        "    MIN_BY(input_price_usd_per_mtok, snapshot_date)  AS first_input_price,\n",
        "    MAX_BY(input_price_usd_per_mtok, snapshot_date)  AS latest_input_price,\n",
        "    MIN_BY(output_price_usd_per_mtok, snapshot_date) AS first_output_price,\n",
        "    MAX_BY(output_price_usd_per_mtok, snapshot_date) AS latest_output_price,\n",
        "    COUNT(DISTINCT input_price_usd_per_mtok) > 1 OR COUNT(DISTINCT output_price_usd_per_mtok) > 1 AS price_changed\n",
        "  FROM prices\n",
        "  GROUP BY 1, 2\n",
        ")\n",
        "SELECT\n",
        "  p.epoch_model_name AS model_name,\n",
        "  d.organization,\n",
        "  p.openrouter_model_id,\n",
        "  p.first_seen,\n",
        "  p.last_seen,\n",
        "  -- DOUBLE only for display: the dashboard formats floating-point numbers, not DECIMAL\n",
        "  CAST(p.first_input_price AS DOUBLE) AS first_input_price,\n",
        "  CAST(p.latest_input_price AS DOUBLE) AS latest_input_price,\n",
        "  CAST(p.first_output_price AS DOUBLE) AS first_output_price,\n",
        "  CAST(p.latest_output_price AS DOUBLE) AS latest_output_price,\n",
        "  CAST(ROUND(CASE WHEN p.first_output_price > 0\n",
        "       THEN 100 * (p.latest_output_price - p.first_output_price) / p.first_output_price END, 0) AS DOUBLE) AS output_price_change_pct\n",
        "FROM per_listing p\n",
        "JOIN dim_models d ON d.model_name = p.epoch_model_name\n",
        "WHERE p.price_changed\n",
        "ORDER BY ABS(COALESCE(p.latest_output_price - p.first_output_price, 0)) DESC, p.epoch_model_name"
      ]
    }
  ],
